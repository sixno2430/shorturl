# PostgreSQL connection string
# Local (docker compose):  postgres://postgres:postgres@localhost:5432/shorturl
# Neon / Supabase:         postgres://user:pass@host/db?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shorturl

PORT=3000

# Optional: the public address used to build short links and QR codes.
# Leave empty to use the address of the incoming request.
PUBLIC_BASE_URL=

# Optional: salt for hashing visitor IPs (IPs are never stored in plain text)
IP_HASH_SALT=change-me

# Optional: max links one IP can create per minute
CREATE_RATE_LIMIT=30
